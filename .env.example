# Copy this file to .env.local and replace every placeholder. Set the server
# keys as GitHub Actions secrets as well. Never commit real keys to this file.

GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_REGION_CODES=US,GB,IN,ID,BR,JP,DE,MX

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Server-side only; never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Safe to expose in the Next.js browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# Cloudflare Access protects /admin/* and signs the admin identity for the Worker.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your_access_application_audience_tag
GUIDE_ADMIN_EMAIL=your-email@example.com
# Public contact address for the Contact page. This is safe to expose.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Optional Guide worker keys; blank values reuse the existing news keys.
# These names do NOT create additional provider quota.
TAVILY_GUIDE_API_KEY=
GEMINI_GUIDE_API_KEY=
# Optional; defaults to the same model currently used by News and Topics.
GUIDE_GEMINI_MODEL=
# Guide-only reservations; they do not count News/Topics usage.
GUIDE_TAVILY_MONTHLY_LIMIT=100
GUIDE_GEMINI_DAILY_LIMIT=2
# Enable after checking a first draft end to end.
GUIDE_AUTO_REVIEW=false
# Cloudflare Pages Function runtime: used only after Publish / Retry rebuild.
CLOUDFLARE_DEPLOY_HOOK_URL=
 
 SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
TAVILY_API_KEY
GEMINI_API_KEY