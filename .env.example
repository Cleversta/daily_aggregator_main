# Copy this file to .env.local and replace every placeholder. Set the server
# keys as GitHub Actions secrets as well. Never commit real keys to this file.

GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_REGION_CODES=US,GB,IN,ID,BR,JP,DE,MX

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Server-side only; never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Safe to expose in the Next.js browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
# Public contact address for the Contact page. This is safe to expose.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
