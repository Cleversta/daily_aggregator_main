[build]
  command = "npm run build"
  publish = "out"
  functions = "netlify/functions"

# Static export can't run API routes (output: 'export' in next.config.js),
# so the subscribe/confirm/unsubscribe endpoints live here instead. They're
# reachable at /.netlify/functions/<name> once deployed.
[functions]
  node_bundler = "esbuild"